---
const personalImageAlt = "Rigoberto Miranda";

import GitHub from "./icons/GitHub.astro";
import MailIcon from "./icons/Mail.astro";
import LinkedInIcon from "./icons/LinkedIn.astro";
import File from "./icons/File.astro";
import Badge from "./Badge.astro";
import SocialPill from "./SocialPill.astro";
---

<section class="grid items-center gap-10 py-12 lg:grid-cols-[1.5fr_1fr]">

  <div>
    <a
      href="https://www.linkedin.com/in/rigoberto-miranda/"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block mb-6 transition hover:scale-105"
    >
      <Badge>Disponible para trabajar</Badge>
    </a>

    <h1 class="text-5xl font-bold tracking-tight text-slate-900 dark:text-white">
      Hey, soy Rigoberto Miranda 👋
    </h1>

    <p class="mt-6 text-lg leading-8 text-slate-600 dark:text-slate-300">
      Soy un
      <strong class="font-semibold text-yellow-500 dark:text-yellow-300">
        desarrollador Full Stack
      </strong>
      apasionado por crear aplicaciones web modernas,
      escalables y de alto rendimiento.
    </p>

    <div
      class="mt-6 space-y-4 text-slate-600 dark:text-slate-300
      [&>p>strong]:font-semibold
      [&>p>strong]:text-yellow-500
      dark:[&>p>strong]:text-yellow-300"
    >
      <p>
        Disfruto aprender nuevas tecnologías y convertir ideas en soluciones
        prácticas mediante el desarrollo de software.
      </p>

      <p>
        Mi objetivo es crear aplicaciones
        <strong>eficientes, mantenibles y con una excelente experiencia de usuario.</strong>
      </p>
    </div>

    <nav class="mt-10 flex flex-wrap gap-4">
      <SocialPill href="mailto:rigoberto.miranda1503@gmail.com">
        <MailIcon />
        rigoberto.miranda1503@gmail.com
      </SocialPill>

      <SocialPill href="https://www.linkedin.com/in/rigoberto-miranda/">
        <LinkedInIcon />
      </SocialPill>

      <SocialPill href="https://github.com/Rignu1503">
        <GitHub />
      </SocialPill>

      <SocialPill href="https://drive.google.com/file/d/18AHoWS0fjawLU4GAoOedhYzQZypJd5WU/view?usp=sharing">
        <File />
      </SocialPill>
    </nav>
  </div>

  <div class="flex justify-center">
    <img
      src="/me.webp"
      alt={personalImageAlt}
      width="340"
      height="340"
      class="aspect-square w-72 rounded-3xl border border-slate-200 bg-white p-2 object-cover shadow-2xl rotate-3 dark:border-slate-700 dark:bg-slate-900"
      style="object-position: 50% 50%;"
    />
  </div>

</section>